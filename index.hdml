<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>La Circunferencia en Movimiento - Aplicación Interactiva</title> <!-- Chosen Palette: Warm Scientific Neutral (Background: #F8FAFC / #F1F5F9, Primary Accent: #2563EB Indigo Blue, Secondary Accent: #0D9488 Teal, Warm Neutral Card: #FFFFFF, Text: #1E293B Slate) -->
    <!-- Application Structure Plan: 
         The app is structured as an interactive educational dashboard with 5 primary sections:
         1. Header & Hero: Contextual introduction and credits ("Hecho por Angel G., Diego V. y compañía").
         2. Interactive Geometry & Equation Explorer: Visualizes standard equation (x-h)^2 + (y-k)^2 = r^2 and parametric form x(t), y(t) with an interactive Canvas plot.
         3. Angular Measures & Dynamic Converter: Live converter between Degrees and Radians, plus an interactive reference wheel for key angles.
         4. Circular Motion Kinematics & Simulator: Real-time simulation of fan/cyclist motion with live speed/acceleration adjustment and Chart.js kinematics graphs.
         5. Angular Momentum & Physics Mechanics: Visual interactive skater/rigid body moment of inertia demonstrator.
         6. Formative Quiz & Activities: Interactive self-grading assessment containing all questions from the source text with step-by-step explanations.
         
         Rationale: This structure transitions logically from pure geometry to kinematics, then to dynamic energy/physics, and concludes with active user testing to solidify learning.
    -->
    <!-- Visualization & Content Choices:
         - Standard Circle Equation -> Interactive Canvas Grid -> Allows dragging center (h,k) and slider for radius r -> Vanilla JS + HTML5 Canvas (No SVG).
         - Kinematics -> Fan/Cyclist Circular Animation + Chart.js Line Chart -> Live tracking of angular displacement, velocity, and acceleration over time.
         - Moment of Inertia -> Interactive Skater Animation (Arm position slider affecting rotational speed w) -> HTML5 Canvas.
         - Quiz -> Self-grading interactive form cards with immediate feedback.
    -->
    <!-- CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. -->
    
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        .chart-container {
            position: relative;
            width: 100%;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
            height: 280px;
            max-height: 350px;
        }
        @media (min-width: 768px) {
            .chart-container {
                height: 320px;
            }
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans leading-relaxed antialiased min-h-screen flex flex-col">

    <!-- Header Navigation -->
    <header class="bg-slate-900 text-white sticky top-0 z-50 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-full bg-blue-500 flex items-center justify-center font-bold text-lg text-white">
                        &#9675;
                    </div>
                    <div>
                        <span class="font-bold text-lg tracking-wide block leading-tight">Circunferencia en Movimiento</span>
                        <span class="text-xs text-slate-400 block">Física & Matemáticas Interactivas</span>
                    </div>
                </div>
                <nav class="hidden md:flex space-x-1 text-sm font-medium">
                    <button onclick="scrollToSection('ecuaciones')" class="px-3 py-2 rounded-md hover:bg-slate-800 transition">Ecuaciones</button>
                    <button onclick="scrollToSection('medidas')" class="px-3 py-2 rounded-md hover:bg-slate-800 transition">Medidas Angulares</button>
                    <button onclick="scrollToSection('cinematica')" class="px-3 py-2 rounded-md hover:bg-slate-800 transition">Cinemática Circular</button>
                    <button onclick="scrollToSection('momento')" class="px-3 py-2 rounded-md hover:bg-slate-800 transition">Momento Angular</button>
                    <button onclick="scrollToSection('actividades')" class="px-3 py-2 rounded-md bg-blue-600 hover:bg-blue-500 text-white transition">Actividades</button>
                </nav>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">

        <!-- Hero & Credits Banner -->
        <section class="bg-gradient-to-r from-slate-900 via-blue-950 to-slate-900 text-white rounded-2xl p-6 md:p-10 shadow-xl relative overflow-hidden">
            <div class="relative z-10 max-w-3xl">
                <span class="inline-block px-3 py-1 bg-blue-500/20 text-blue-300 border border-blue-500/30 rounded-full text-xs font-semibold uppercase tracking-wider mb-3">
                    Progresión de Aprendizaje
                </span>
                <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight mb-4">
                    La Circunferencia en Movimiento
                </h1>
                <p class="text-slate-300 text-base md:text-lg mb-6">
                    Explora de forma visual e interactiva cómo las matemáticas analíticas se conectan con los fenómenos físicos de rotación: desde la ecuación estándar hasta la velocidad angular y la conservación del momento angular.
                </p>
                <div class="inline-flex items-center space-x-2 bg-slate-800/80 backdrop-blur px-4 py-2 rounded-lg border border-slate-700 text-sm text-slate-300">
                    <span class="text-amber-400 font-semibold">&#9733; Creadores:</span>
                    <span>Hecho por <strong>Angel G.</strong>, <strong>Diego V.</strong> y compañía</span>
                </div>
            </div>
        </section>

        <!-- SECTION 1: ECUACIONES Y POSICIÓN -->
        <section id="ecuaciones" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
            <div class="border-b border-slate-200 pb-4">
                <h2 class="text-2xl font-bold text-slate-900 flex items-center space-x-2">
                    <span class="text-blue-600">&#9881;</span>
                    <span>1. La Circunferencia y sus Ecuaciones</span>
                </h2>
                <p class="text-slate-600 text-sm mt-1">
                    Definición geométrica a partir de la distancia entre puntos y representación paramétrica del movimiento continuo.
                </p>
            </div>

            <p class="text-slate-700">
                Para una circunferencia con centro en $(h, k)$, la distancia entre cualquier punto $(x, y)$ sobre ella y el centro equivale al radio $r$:
                <span class="block text-center font-mono bg-slate-100 p-2 rounded-md my-2 text-blue-900 font-semibold">
                    &radic;((x - h)&sup2; + (y - k)&sup2;) = r &nbsp;&rArr;&nbsp; (x - h)&sup2; + (y - k)&sup2; = r&sup2;
                </span>
            </p>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <!-- Interactive Controls & Formula Display -->
                <div class="lg:col-span-5 space-y-4 bg-slate-50 p-5 rounded-xl border border-slate-200">
                    <h3 class="font-bold text-slate-800 text-base border-b pb-2">Explorador de la Ecuación</h3>
                    
                    <div class="space-y-3">
                        <div>
                            <label class="text-xs font-semibold text-slate-600 uppercase tracking-wide flex justify-between">
                                <span>Centro X (h): <strong id="valH" class="text-blue-600">0</strong></span>
                            </label>
                            <input type="range" id="sliderH" min="-5" max="5" value="0" step="1" class="w-full accent-blue-600">
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-slate-600 uppercase tracking-wide flex justify-between">
                                <span>Centro Y (k): <strong id="valK" class="text-blue-600">0</strong></span>
                            </label>
                            <input type="range" id="sliderK" min="-5" max="5" value="0" step="1" class="w-full accent-blue-600">
                        </div>
                        <div>
                            <label class="text-xs font-semibold text-slate-600 uppercase tracking-wide flex justify-between">
                                <span>Radio (r): <strong id="valR" class="text-blue-600">3</strong></span>
                            </label>
                            <input type="range" id="sliderR" min="1" max="6" value="3" step="0.5" class="w-full accent-blue-600">
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-lg border border-slate-200 space-y-2 text-sm font-mono">
                        <div class="text-xs text-slate-500 uppercase font-semibold">Ecuación Estándar Resultante:</div>
                        <div id="equationDisplay" class="text-blue-700 font-bold text-base">(x - 0)&sup2; + (y - 0)&sup2; = 9</div>
                        
                        <div class="text-xs text-slate-500 uppercase font-semibold pt-2 border-t">Ecuaciones Paramétricas en el Tiempo t:</div>
                        <div class="text-emerald-700 font-medium text-xs">x(t) = h + r &middot; cos(&theta;(t))</div>
                        <div class="text-emerald-700 font-medium text-xs">y(t) = k + r &middot; sen(&theta;(t))</div>
                    </div>

                    <!-- Example Callout -->
                    <div class="bg-amber-50 border-l-4 border-amber-500 p-3 rounded text-xs text-amber-900">
                        <strong>Ejemplo Resuelto (Carrusel):</strong> Un carrusel de $r = 5\text{ m}$ centrado en el origen $(0,0)$ cumple la identidad $\cos^2(\theta) + \sen^2(\theta) = 1$, resultando en la ecuación: 
                        <span class="font-bold block mt-1">x&sup2; + y&sup2; = 25</span>
                    </div>
                </div>

                <!-- Canvas Visualizer -->
                <div class="lg:col-span-7 flex flex-col items-center justify-center bg-slate-900 p-4 rounded-xl shadow-inner">
                    <canvas id="circleCanvas" width="400" height="400" class="max-w-full h-auto rounded bg-slate-900 cursor-crosshair"></canvas>
                    <div class="text-xs text-slate-400 mt-2 text-center">
                        Representación en tiempo real en el Plano Cartesiano
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 2: MEDIDAS ANGULARES -->
        <section id="medidas" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
            <div class="border-b border-slate-200 pb-4">
                <h2 class="text-2xl font-bold text-slate-900 flex items-center space-x-2">
                    <span class="text-teal-600">&#8736;</span>
                    <span>2. Medidas Angulares y Conversiones</span>
                </h2>
                <p class="text-slate-600 text-sm mt-1">
                    Comprensión de los sistemas sexagesimal (grados) y de radianes para el cálculo de arcos circulares.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-3">
                    <h3 class="font-bold text-slate-800 text-base">Grados vs. Radianes</h3>
                    <p class="text-sm text-slate-600">
                        <strong>Grados (&deg;):</strong> Divide una circunferencia completa en 360 partes iguales ($1/360$ de vuelta).
                    </p>
                    <p class="text-sm text-slate-600">
                        <strong>Radián (rad):</strong> Ángulo central cuyo arco ($s$) equivale a la longitud del radio ($r$). Una vuelta completa representa $2\pi\text{ rad} \approx 6.28318\text{ rad}$.
                    </p>
                    <div class="bg-white p-3 rounded-lg border text-xs space-y-1 font-mono">
                        <p class="text-blue-800"><strong>Grados &rarr; Radianes:</strong> rad = grados &middot; (&pi; / 180&deg;)</p>
                        <p class="text-teal-800"><strong>Radianes &rarr; Grados:</strong> grados = rad &middot; (180&deg; / &pi;)</p>
                    </div>
                </div>

                <!-- Interactive Calculator -->
                <div class="bg-gradient-to-br from-teal-900 to-slate-900 text-white p-5 rounded-xl shadow border border-teal-800 space-y-4">
                    <h3 class="font-bold text-teal-300 text-base flex items-center justify-between">
                        <span>Calculadora Interactiva en Tiempo Real</span>
                        <span class="text-xs bg-teal-800 text-teal-200 px-2 py-0.5 rounded">Convertidor</span>
                    </h3>

                    <div class="space-y-4 text-sm">
                        <div>
                            <label class="block text-xs font-medium text-teal-200 mb-1">Grados (&deg;):</label>
                            <input type="number" id="inputDegrees" value="45" step="any" class="w-full bg-slate-800 border border-teal-600 rounded px-3 py-2 text-white font-mono focus:outline-none focus:ring-2 focus:ring-teal-400">
                        </div>
                        <div class="text-center font-bold text-teal-400 text-xl">&udarr;</div>
                        <div>
                            <label class="block text-xs font-medium text-teal-200 mb-1">Radianes (rad):</label>
                            <input type="number" id="inputRadians" value="0.7854" step="any" class="w-full bg-slate-800 border border-teal-600 rounded px-3 py-2 text-white font-mono focus:outline-none focus:ring-2 focus:ring-teal-400">
                        </div>
                        <div class="text-xs text-teal-300 bg-teal-950/60 p-2 rounded border border-teal-800/50 font-mono text-center" id="exactFractionDisplay">
                            45&deg; = &pi;/4 rad &approx; 0.7854 rad
                        </div>
                    </div>
                </div>
            </div>

            <!-- Quick Lookup Table -->
            <div class="overflow-x-auto">
                <table class="w-full text-xs text-center border-collapse border border-slate-200">
                    <thead>
                        <tr class="bg-slate-100 text-slate-700 font-semibold">
                            <th class="p-2 border">Grados (&deg;)</th>
                            <th class="p-2 border">30&deg;</th>
                            <th class="p-2 border">45&deg;</th>
                            <th class="p-2 border">60&deg;</th>
                            <th class="p-2 border">90&deg;</th>
                            <th class="p-2 border">120&deg;</th>
                            <th class="p-2 border">180&deg;</th>
                            <th class="p-2 border">270&deg;</th>
                            <th class="p-2 border">360&deg;</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="font-mono bg-white text-slate-800">
                            <td class="p-2 border font-bold bg-slate-50">Radianes</td>
                            <td class="p-2 border">&pi;/6</td>
                            <td class="p-2 border">&pi;/4</td>
                            <td class="p-2 border">&pi;/3</td>
                            <td class="p-2 border">&pi;/2</td>
                            <td class="p-2 border">2&pi;/3</td>
                            <td class="p-2 border">&pi;</td>
                            <td class="p-2 border">3&pi;/2</td>
                            <td class="p-2 border">2&pi;</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- SECTION 3: CINEMÁTICA ANGULAR Y SIMULADOR -->
        <section id="cinematica" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
            <div class="border-b border-slate-200 pb-4">
                <h2 class="text-2xl font-bold text-slate-900 flex items-center space-x-2">
                    <span class="text-indigo-600">&#127939;</span>
                    <span>3. Desplazamiento, Velocidad y Aceleración Angular</span>
                </h2>
                <p class="text-slate-600 text-sm mt-1">
                    Análisis cuantitativo de magnitudes rotacionales en sistemas en movimiento.
                </p>
            </div>

            <!-- Formula Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
                <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
                    <span class="text-xs font-bold text-indigo-600 uppercase block mb-1">Desplazamiento Angular (&Delta;&theta;)</span>
                    <p class="text-slate-600 text-xs mb-2">Ángulo total recorrido en la trayectoria circular.</p>
                    <div class="font-mono text-center bg-white p-2 rounded border font-semibold">
                        &Delta;&theta; = &theta;<sub>f</sub> - &theta;<sub>i</sub> = s / r
                    </div>
                    <span class="text-[11px] text-slate-500 block mt-1 text-center">(s = longitud de arco, r = radio)</span>
                </div>

                <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
                    <span class="text-xs font-bold text-indigo-600 uppercase block mb-1">Velocidad Angular (&omega;)</span>
                    <p class="text-slate-600 text-xs mb-2">Rapidez con la que cambia el ángulo en el tiempo.</p>
                    <div class="font-mono text-center bg-white p-2 rounded border font-semibold">
                        &omega; = &Delta;&theta; / &Delta;t &nbsp; (rad/s)
                    </div>
                    <span class="text-[11px] text-slate-500 block mt-1 text-center">Regla de la mano derecha</span>
                </div>

                <div class="bg-slate-50 p-4 rounded-lg border border-slate-200">
                    <span class="text-xs font-bold text-indigo-600 uppercase block mb-1">Aceleración Angular (&alpha;)</span>
                    <p class="text-slate-600 text-xs mb-2">Variación de la velocidad angular por unidad de tiempo.</p>
                    <div class="font-mono text-center bg-white p-2 rounded border font-semibold">
                        &alpha; = &Delta;&omega; / &Delta;t &nbsp; (rad/s&sup2;)
                    </div>
                    <span class="text-[11px] text-slate-500 block mt-1 text-center">&alpha; &gt; 0 (Acelera), &alpha; &lt; 0 (Frena)</span>
                </div>
            </div>

            <!-- Interactive Fan / Cyclist Simulator -->
            <div class="bg-slate-900 text-white rounded-xl p-6 space-y-6">
                <div class="flex flex-col md:flex-row md:items-center justify-between border-b border-slate-800 pb-4 gap-4">
                    <div>
                        <h3 class="text-lg font-bold text-blue-400">Simulador de Movimiento Circular (Ventilador / Ciclista)</h3>
                        <p class="text-xs text-slate-400">Ajusta los parámetros para simular la rotación física en tiempo real.</p>
                    </div>
                    <div class="flex space-x-2">
                        <button id="btnSimStart" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-4 py-2 rounded transition">Iniciar</button>
                        <button id="btnSimPause" class="bg-amber-600 hover:bg-amber-500 text-white text-xs font-bold px-4 py-2 rounded transition">Pausar</button>
                        <button id="btnSimReset" class="bg-slate-700 hover:bg-slate-600 text-white text-xs font-bold px-4 py-2 rounded transition">Reiniciar</button>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
                    <!-- Controls -->
                    <div class="lg:col-span-4 space-y-4 text-xs">
                        <div>
                            <label class="font-medium text-slate-300 flex justify-between">
                                <span>Radio (r): <strong id="simRadiusVal" class="text-blue-400">0.60 m</strong></span>
                            </label>
                            <input type="range" id="simRadius" min="0.1" max="2.0" value="0.6" step="0.05" class="w-full accent-blue-500">
                        </div>

                        <div>
                            <label class="font-medium text-slate-300 flex justify-between">
                                <span>Velocidad Angular (&omega;): <strong id="simOmegaVal" class="text-blue-400">1.88 rad/s</strong></span>
                            </label>
                            <input type="range" id="simOmega" min="0" max="10" value="1.88" step="0.1" class="w-full accent-blue-500">
                        </div>

                        <div>
                            <label class="font-medium text-slate-300 flex justify-between">
                                <span>Aceleración Angular (&alpha;): <strong id="simAlphaVal" class="text-blue-400">0.00 rad/s&sup2;</strong></span>
                            </label>
                            <input type="range" id="simAlpha" min="-2" max="2" value="0" step="0.05" class="w-full accent-blue-500">
                        </div>

                        <!-- Live Metrics Box -->
                        <div class="bg-slate-800 p-3 rounded-lg border border-slate-700 space-y-1.5 font-mono">
                            <div class="text-[11px] text-slate-400 uppercase font-semibold">Cálculos en Tiempo Real:</div>
                            <div class="flex justify-between text-slate-300"><span>Tiempo (t):</span> <span id="simTime" class="text-amber-400 font-bold">0.0 s</span></div>
                            <div class="flex justify-between text-slate-300"><span>Desplazamiento (&Delta;&theta;):</span> <span id="simTheta" class="text-emerald-400 font-bold">0.00 rad</span></div>
                            <div class="flex justify-between text-slate-300"><span>Arco Recorrido (s):</span> <span id="simArco" class="text-teal-400 font-bold">0.00 m</span></div>
                            <div class="flex justify-between text-slate-300"><span>Vel. Tangencial (v):</span> <span id="simVTang" class="text-blue-400 font-bold">0.00 m/s</span></div>
                        </div>
                    </div>

                    <!-- Canvas Visual Animation -->
                    <div class="lg:col-span-4 flex flex-col items-center justify-center">
                        <canvas id="fanCanvas" width="300" height="300" class="bg-slate-950 rounded-lg border border-slate-800 shadow"></canvas>
                        <span class="text-[11px] text-slate-400 mt-2">Visualización de la rotación con vector de velocidad</span>
                    </div>

                    <!-- Chart.js Dynamics Container -->
                    <div class="lg:col-span-4 bg-slate-950 p-3 rounded-lg border border-slate-800 flex flex-col items-center">
                        <div class="w-full text-center text-xs text-slate-400 font-semibold mb-1">Gráfica &omega; vs Tiempo</div>
                        <div class="chart-container">
                            <canvas id="kinematicsChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 4: MOMENTO ANGULAR -->
        <section id="momento" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
            <div class="border-b border-slate-200 pb-4">
                <h2 class="text-2xl font-bold text-slate-900 flex items-center space-x-2">
                    <span class="text-amber-600">&#9878;</span>
                    <span>4. Momento Angular y Ley de Conservación</span>
                </h2>
                <p class="text-slate-600 text-sm mt-1">
                    Magnitud física que describe la rotación de un sistema e inercia rotacional.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Theory & Formulas -->
                <div class="space-y-4 text-sm text-slate-700">
                    <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 space-y-2">
                        <h3 class="font-bold text-slate-900">Ecuaciones del Momento Angular (L)</h3>
                        <ul class="list-disc list-inside space-y-1 text-xs">
                            <li><strong>Partícula Puntual:</strong> L = m &middot; &omega; &middot; r&sup2;</li>
                            <li><strong>Cuerpo Rígido:</strong> L = I &middot; &omega; (donde <em>I</em> es el momento de inercia).</li>
                        </ul>
                    </div>

                    <div class="bg-amber-50 border-l-4 border-amber-500 p-4 rounded-r-lg space-y-2">
                        <h4 class="font-bold text-amber-900 text-sm">Principio de Conservación</h4>
                        <p class="text-xs text-amber-800">
                            En un sistema aislado donde no actúan momentos de fuerza (torques) externos, el momento angular total permanece constante:
                        </p>
                        <div class="font-mono text-center font-bold text-amber-950 text-sm">
                            L<sub>inicial</sub> = L<sub>final</sub> &nbsp;&rArr;&nbsp; I<sub>1</sub> &middot; &omega;<sub>1</sub> = I<sub>2</sub> &middot; &omega;<sub>2</sub>
                        </div>
                    </div>
                </div>

                <!-- Rigid Body Moments of Inertia Reference Interactive Box -->
                <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 space-y-3 text-xs">
                    <h3 class="font-bold text-slate-800 text-sm">Momentos de Inercia Típicos (I)</h3>
                    <div class="grid grid-cols-2 gap-2 font-mono">
                        <div class="bg-white p-2 rounded border">
                            <span class="font-bold block text-slate-900">Cilindro Sólido</span>
                            <span class="text-blue-600">I = &frac12; m r&sup2;</span>
                        </div>
                        <div class="bg-white p-2 rounded border">
                            <span class="font-bold block text-slate-900">Anillo Delgado</span>
                            <span class="text-blue-600">I = m r&sup2;</span>
                        </div>
                        <div class="bg-white p-2 rounded border">
                            <span class="font-bold block text-slate-900">Esfera Sólida</span>
                            <span class="text-blue-600">I = 2/5 m r&sup2;</span>
                        </div>
                        <div class="bg-white p-2 rounded border">
                            <span class="font-bold block text-slate-900">Varilla (Centro)</span>
                            <span class="text-blue-600">I = 1/12 m L&sup2;</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Skater Demonstration Simulator -->
            <div class="bg-slate-900 text-white rounded-xl p-6 space-y-4">
                <h3 class="text-base font-bold text-amber-400">Demostración Interactiva: El Patinador sobre Hielo</h3>
                <p class="text-xs text-slate-300">
                    Al recoger sus brazos, el patinador disminuye su momento de inercia ($I$), lo que provoca un incremento inmediato en su velocidad angular ($\omega$).
                </p>

                <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
                    <div class="md:col-span-5 space-y-4 text-xs">
                        <div>
                            <label class="font-medium text-slate-300 flex justify-between mb-1">
                                <span>Posición de los Brazos: <strong id="skaterArmLabel" class="text-amber-400">Extendidos</strong></span>
                            </label>
                            <input type="range" id="skaterArmSlider" min="0" max="1" step="0.01" value="0" class="w-full accent-amber-500">
                        </div>

                        <div class="bg-slate-800 p-3 rounded border border-slate-700 space-y-1 font-mono text-slate-300">
                            <div>Momento de Inercia (I): <strong id="skaterIVal" class="text-blue-400">3.33 kg&middot;m&sup2;</strong></div>
                            <div>Velocidad Angular (&omega;): <strong id="skaterWVal" class="text-amber-400">2.00 rad/s</strong></div>
                            <div>Momento Angular (L = I&middot;&omega;): <strong class="text-emerald-400">6.67 kg&middot;m&sup2;/s (Constante)</strong></div>
                        </div>
                    </div>

                    <div class="md:col-span-7 flex flex-col items-center justify-center">
                        <canvas id="skaterCanvas" width="320" height="220" class="bg-slate-950 rounded border border-slate-800"></canvas>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION 5: ACTIVIDADES FORMATIVAS & QUIZ -->
        <section id="actividades" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6 md:p-8 space-y-6">
            <div class="border-b border-slate-200 pb-4 flex items-center justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900 flex items-center space-x-2">
                        <span class="text-emerald-600">&#9997;</span>
                        <span>5. Actividades Formativas y Evaluación</span>
                    </h2>
                    <p class="text-slate-600 text-sm mt-1">
                        Ponte a prueba resolviendo los ejercicios clave extraídos de las actividades del libro.
                    </p>
                </div>
                <div id="quizScoreBadge" class="hidden bg-emerald-100 text-emerald-800 font-bold px-3 py-1 rounded-full text-sm">
                    Puntaje: <span id="quizScoreText">0/4</span>
                </div>
            </div>

            <div class="space-y-6" id="quizContainer">
                <!-- Question 1 -->
                <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-3" id="qCard1">
                    <span class="text-xs font-bold text-emerald-700 uppercase tracking-wide">Ejercicio 1: El Ventilador</span>
                    <p class="text-sm font-medium text-slate-800">
                        Un ventilador comienza a girar desde el reposo. Las aspas tienen un radio $r = 0.6\text{ m}$. En los primeros $5\text{ s}$, la punta de una de las aspas recorre un arco $s = 9.42\text{ m}$. ¿Cuál es su desplazamiento angular $\Delta\theta$?
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                        <button onclick="checkAnswer(1, 'a', false)" class="qBtn1 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">a) 5.65 rad</button>
                        <button onclick="checkAnswer(1, 'b', true)" class="qBtn1 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">b) 15.70 rad (&Delta;&theta; = 9.42 / 0.6)</button>
                        <button onclick="checkAnswer(1, 'c', false)" class="qBtn1 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">c) 3.14 rad</button>
                        <button onclick="checkAnswer(1, 'd', false)" class="qBtn1 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">d) 1.88 rad</button>
                    </div>
                    <div id="qFeedback1" class="hidden text-xs p-3 rounded font-medium"></div>
                </div>

                <!-- Question 2 -->
                <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-3" id="qCard2">
                    <span class="text-xs font-bold text-emerald-700 uppercase tracking-wide">Ejercicio 2: Velocidad Angular del Ventilador</span>
                    <p class="text-sm font-medium text-slate-800">
                        Con los datos del ejercicio anterior ($\Delta\theta = 15.7\text{ rad}$ en $\Delta t = 5\text{ s}$), ¿cuál es la velocidad angular $\omega$ a los $5\text{ segundos}$?
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                        <button onclick="checkAnswer(2, 'a', false)" class="qBtn2 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">a) 0.628 rad/s</button>
                        <button onclick="checkAnswer(2, 'b', false)" class="qBtn2 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">b) 5.00 rad/s</button>
                        <button onclick="checkAnswer(2, 'c', true)" class="qBtn2 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">c) 3.14 rad/s (&omega; = 15.7 / 5)</button>
                        <button onclick="checkAnswer(2, 'd', false)" class="qBtn2 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">d) 0.044 rad/s</button>
                    </div>
                    <div id="qFeedback2" class="hidden text-xs p-3 rounded font-medium"></div>
                </div>

                <!-- Question 3 -->
                <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-3" id="qCard3">
                    <span class="text-xs font-bold text-emerald-700 uppercase tracking-wide">Ejercicio 3: Dinámica de Rotación</span>
                    <p class="text-sm font-medium text-slate-800">
                        ¿Qué fuerza mantiene a un objeto en movimiento circular dirigiendo su aceleración constantemente hacia el centro?
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                        <button onclick="checkAnswer(3, 'a', true)" class="qBtn3 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">a) Fuerza Centrípeta</button>
                        <button onclick="checkAnswer(3, 'b', false)" class="qBtn3 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">b) Fuerza Centrífuga Ficticia</button>
                        <button onclick="checkAnswer(3, 'c', false)" class="qBtn3 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">c) Torque Externo</button>
                        <button onclick="checkAnswer(3, 'd', false)" class="qBtn3 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">d) Momento de Inercia Variable</button>
                    </div>
                    <div id="qFeedback3" class="hidden text-xs p-3 rounded font-medium"></div>
                </div>

                <!-- Question 4 -->
                <div class="bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-3" id="qCard4">
                    <span class="text-xs font-bold text-emerald-700 uppercase tracking-wide">Ejercicio 4: Conservación del Momento Angular</span>
                    <p class="text-sm font-medium text-slate-800">
                        Si un patinador en rotación reduce su momento de inercia $I$ a la mitad sin que actúen fuerzas externas, ¿qué ocurre con su velocidad angular $\omega$?
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                        <button onclick="checkAnswer(4, 'a', false)" class="qBtn4 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">a) Se reduce a la mitad</button>
                        <button onclick="checkAnswer(4, 'b', true)" class="qBtn4 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">b) Se duplica (&omega;&sub2; = 2 &middot; &omega;&sub1;)</button>
                        <button onclick="checkAnswer(4, 'c', false)" class="qBtn4 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">c) Permanece exactamente igual</button>
                        <button onclick="checkAnswer(4, 'd', false)" class="qBtn4 text-left p-2.5 rounded border bg-white hover:bg-slate-100 transition">d) Cae a cero</button>
                    </div>
                    <div id="qFeedback4" class="hidden text-xs p-3 rounded font-medium"></div>
                </div>
            </div>
        </section>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 text-xs py-6 border-t border-slate-800 mt-12">
        <div class="max-w-7xl mx-auto px-4 text-center space-y-2">
            <p class="text-slate-300 font-semibold">Sitio Web Interactivo: La Circunferencia en Movimiento</p>
            <p>Creado por <strong>Angel G.</strong>, <strong>Diego V.</strong> y compañía</p>
            <p class="text-slate-500">&copy; 2026 Material Educativo Interactivo - Todos los derechos reservados.</p>
        </div>
    </footer>

    <!-- JavaScript Logic -->
    <script>
        // Smooth Navigation
        function scrollToSection(id) {
            const el = document.getElementById(id);
            if(el) {
                el.scrollIntoView({ behavior: 'smooth' });
            }
        }

        // ==========================================
        // SECTION 1: CIRCLE GEOMETRY CANVAS
        // ==========================================
        const circleCanvas = document.getElementById('circleCanvas');
        const ctxCircle = circleCanvas.getContext('2d');
        const sliderH = document.getElementById('sliderH');
        const sliderK = document.getElementById('sliderK');
        const sliderR = document.getElementById('sliderR');
        const valH = document.getElementById('valH');
        const valK = document.getElementById('valK');
        const valR = document.getElementById('valR');
        const eqDisplay = document.getElementById('equationDisplay');

        let angleT = 0;

        function drawCirclePlot() {
            const h = parseFloat(sliderH.value);
            const k = parseFloat(sliderK.value);
            const r = parseFloat(sliderR.value);

            valH.innerText = h;
            valK.innerText = k;
            valR.innerText = r;

            const hSign = h >= 0 ? `- ${h}` : `+ ${Math.abs(h)}`;
            const kSign = k >= 0 ? `- ${k}` : `+ ${Math.abs(k)}`;
            eqDisplay.innerHTML = `(x ${hSign})&sup2; + (y ${kSign})&sup2; = ${r*r}`;

            const width = circleCanvas.width;
            const height = circleCanvas.height;
            const originX = width / 2;
            const originY = height / 2;
            const scale = 25; // 25 px = 1 unit

            ctxCircle.clearRect(0, 0, width, height);

            // Draw Cartesian Grid
            ctxCircle.strokeStyle = '#334155';
            ctxCircle.lineWidth = 1;
            for(let x = 0; x <= width; x += scale) {
                ctxCircle.beginPath();
                ctxCircle.moveTo(x, 0);
                ctxCircle.lineTo(x, height);
                ctxCircle.stroke();
            }
            for(let y = 0; y <= height; y += scale) {
                ctxCircle.beginPath();
                ctxCircle.moveTo(0, y);
                ctxCircle.lineTo(width, y);
                ctxCircle.stroke();
            }

            // Draw Main Axes
            ctxCircle.strokeStyle = '#94a3b8';
            ctxCircle.lineWidth = 2;
            ctxCircle.beginPath();
            ctxCircle.moveTo(0, originY);
            ctxCircle.lineTo(width, originY);
            ctxCircle.moveTo(originX, 0);
            ctxCircle.lineTo(originX, height);
            ctxCircle.stroke();

            // Screen coords for Center (h,k)
            const cx = originX + h * scale;
            const cy = originY - k * scale;

            // Draw Circle
            ctxCircle.strokeStyle = '#3b82f6';
            ctxCircle.lineWidth = 3;
            ctxCircle.beginPath();
            ctxCircle.arc(cx, cy, r * scale, 0, Math.PI * 2);
            ctxCircle.stroke();

            // Draw Center Point
            ctxCircle.fillStyle = '#ef4444';
            ctxCircle.beginPath();
            ctxCircle.arc(cx, cy, 4, 0, Math.PI * 2);
            ctxCircle.fill();

            // Draw Dynamic Point x(t), y(t)
            angleT += 0.03;
            const px = cx + (r * scale) * Math.cos(angleT);
            const py = cy - (r * scale) * Math.sin(angleT);

            // Radius Line
            ctxCircle.strokeStyle = '#10b981';
            ctxCircle.lineWidth = 2;
            ctxCircle.beginPath();
            ctxCircle.moveTo(cx, cy);
            ctxCircle.lineTo(px, py);
            ctxCircle.stroke();

            // Rotating Point
            ctxCircle.fillStyle = '#10b981';
            ctxCircle.beginPath();
            ctxCircle.arc(px, py, 6, 0, Math.PI * 2);
            ctxCircle.fill();

            requestAnimationFrame(drawCirclePlot);
        }

        sliderH.addEventListener('input', drawCirclePlot);
        sliderK.addEventListener('input', drawCirclePlot);
        sliderR.addEventListener('input', drawCirclePlot);
        drawCirclePlot();


        // ==========================================
        // SECTION 2: ANGULAR CONVERTER
        // ==========================================
        const inputDeg = document.getElementById('inputDegrees');
        const inputRad = document.getElementById('inputRadians');
        const exactFractionDisplay = document.getElementById('exactFractionDisplay');

        inputDeg.addEventListener('input', () => {
            const deg = parseFloat(inputDeg.value) || 0;
            const rad = deg * (Math.PI / 180);
            inputRad.value = rad.toFixed(4);
            updateFractionDisplay(deg, rad);
        });

        inputRad.addEventListener('input', () => {
            const rad = parseFloat(inputRad.value) || 0;
            const deg = rad * (180 / Math.PI);
            inputDeg.value = deg.toFixed(2);
            updateFractionDisplay(deg, rad);
        });

        function updateFractionDisplay(deg, rad) {
            exactFractionDisplay.innerHTML = `${deg.toFixed(1)}&deg; = ${(rad / Math.PI).toFixed(2)}&pi; rad &approx; ${rad.toFixed(4)} rad`;
        }


        // ==========================================
        // SECTION 3: KINEMATICS SIMULATOR & CHART.JS
        // ==========================================
        const fanCanvas = document.getElementById('fanCanvas');
        const ctxFan = fanCanvas.getContext('2d');

        const simRadius = document.getElementById('simRadius');
        const simOmega = document.getElementById('simOmega');
        const simAlpha = document.getElementById('simAlpha');

        const simRadiusVal = document.getElementById('simRadiusVal');
        const simOmegaVal = document.getElementById('simOmegaVal');
        const simAlphaVal = document.getElementById('simAlphaVal');

        const simTime = document.getElementById('simTime');
        const simTheta = document.getElementById('simTheta');
        const simArco = document.getElementById('simArco');
        const simVTang = document.getElementById('simVTang');

        let isRunning = false;
        let time = 0;
        let currentTheta = 0;
        let currentOmega = parseFloat(simOmega.value);
        let animId = null;

        // Chart.js Configuration
        const chartCtx = document.getElementById('kinematicsChart').getContext('2d');
        const kinematicsChart = new Chart(chartCtx, {
            type: 'line',
            data: {
                labels: [],
                datasets: [{
                    label: 'Vel. Angular \u03C9 (rad/s)',
                    data: [],
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    x: {
                        ticks: { color: '#94a3b8', font: { size: 10 } },
                        grid: { color: '#334155' }
                    },
                    y: {
                        ticks: { color: '#94a3b8', font: { size: 10 } },
                        grid: { color: '#334155' }
                    }
                },
                plugins: {
                    legend: { labels: { color: '#e2e8f0', font: { size: 10 } } }
                }
            }
        });

        function updateSimParams() {
            simRadiusVal.innerText = `${parseFloat(simRadius.value).toFixed(2)} m`;
            simOmegaVal.innerText = `${parseFloat(simOmega.value).toFixed(2)} rad/s`;
            simAlphaVal.innerText = `${parseFloat(simAlpha.value).toFixed(2)} rad/s\u00B2`;
        }

        simRadius.addEventListener('input', updateSimParams);
        simOmega.addEventListener('input', () => {
            currentOmega = parseFloat(simOmega.value);
            updateSimParams();
        });
        simAlpha.addEventListener('input', updateSimParams);

        function drawFanFrame() {
            const dt = 0.03; // ~30fps step
            const alpha = parseFloat(simAlpha.value);
            const radius = parseFloat(simRadius.value);

            if (isRunning) {
                time += dt;
                currentOmega += alpha * dt;
                if (currentOmega < 0) currentOmega = 0;
                currentTheta += currentOmega * dt;

                // Update Chart every second step
                if (Math.floor(time * 10) % 2 === 0) {
                    if (kinematicsChart.data.labels.length > 20) {
                        kinematicsChart.data.labels.shift();
                        kinematicsChart.data.datasets[0].data.shift();
                    }
                    kinematicsChart.data.labels.push(time.toFixed(1) + 's');
                    kinematicsChart.data.datasets[0].data.push(currentOmega.toFixed(2));
                    kinematicsChart.update('none');
                }
            }

            const arco = currentTheta * radius;
            const vTang = currentOmega * radius;

            simTime.innerText = `${time.toFixed(1)} s`;
            simTheta.innerText = `${currentTheta.toFixed(2)} rad`;
            simArco.innerText = `${arco.toFixed(2)} m`;
            simVTang.innerText = `${vTang.toFixed(2)} m/s`;

            // Canvas Render
            const w = fanCanvas.width;
            const h = fanCanvas.height;
            const cx = w / 2;
            const cy = h / 2;

            ctxFan.clearRect(0, 0, w, h);

            // Draw Outer Ring
            ctxFan.strokeStyle = '#475569';
            ctxFan.lineWidth = 4;
            ctxFan.beginPath();
            ctxFan.arc(cx, cy, 100, 0, Math.PI * 2);
            ctxFan.stroke();

            // Draw Fan Blades
            const blades = 3;
            ctxFan.fillStyle = '#3b82f6';
            for (let i = 0; i < blades; i++) {
                const angle = currentTheta + (i * Math.PI * 2 / blades);
                const bx = cx + Math.cos(angle) * 85;
                const by = cy + Math.sin(angle) * 85;

                ctxFan.beginPath();
                ctxFan.moveTo(cx, cy);
                ctxFan.lineTo(bx, by);
                ctxFan.lineWidth = 12;
                ctxFan.strokeStyle = '#2563eb';
                ctxFan.stroke();
            }

            // Center Point
            ctxFan.fillStyle = '#f59e0b';
            ctxFan.beginPath();
            ctxFan.arc(cx, cy, 10, 0, Math.PI * 2);
            ctxFan.fill();

            // Tangential Vector Arrow
            const tipX = cx + Math.cos(currentTheta) * 85;
            const tipY = cy + Math.sin(currentTheta) * 85;
            const tanAngle = currentTheta + Math.PI / 2;

            ctxFan.strokeStyle = '#10b981';
            ctxFan.lineWidth = 3;
            ctxFan.beginPath();
            ctxFan.moveTo(tipX, tipY);
            ctxFan.lineTo(tipX + Math.cos(tanAngle) * 30, tipY + Math.sin(tanAngle) * 30);
            ctxFan.stroke();

            animId = requestAnimationFrame(drawFanFrame);
        }

        document.getElementById('btnSimStart').addEventListener('click', () => { isRunning = true; });
        document.getElementById('btnSimPause').addEventListener('click', () => { isRunning = false; });
        document.getElementById('btnSimReset').addEventListener('click', () => {
            isRunning = false;
            time = 0;
            currentTheta = 0;
            currentOmega = parseFloat(simOmega.value);
            kinematicsChart.data.labels = [];
            kinematicsChart.data.datasets[0].data = [];
            kinematicsChart.update();
        });

        drawFanFrame();


        // ==========================================
        // SECTION 4: ANGULAR MOMENTUM SKATER CANVAS
        // ==========================================
        const skaterCanvas = document.getElementById('skaterCanvas');
        const ctxSkater = skaterCanvas.getContext('2d');
        const skaterArmSlider = document.getElementById('skaterArmSlider');
        const skaterArmLabel = document.getElementById('skaterArmLabel');
        const skaterIVal = document.getElementById('skaterIVal');
        const skaterWVal = document.getElementById('skaterWVal');

        let skaterAngle = 0;

        function drawSkater() {
            const factor = parseFloat(skaterArmSlider.value); // 0 (extended) to 1 (retracted)
            
            // Moment of Inertia decreases as arms pull in
            const I = 3.33 * (1 - 0.6 * factor); 
            const L = 6.67; // Constant angular momentum
            const omega = L / I;

            skaterArmLabel.innerText = factor > 0.5 ? 'Recogidos' : 'Extendidos';
            skaterIVal.innerText = `${I.toFixed(2)} kg\u00B7m\u00B2`;
            skaterWVal.innerText = `${omega.toFixed(2)} rad/s`;

            skaterAngle += omega * 0.02;

            const w = skaterCanvas.width;
            const h = skaterCanvas.height;
            const cx = w / 2;
            const cy = h / 2;

            ctxSkater.clearRect(0, 0, w, h);

            // Ice Floor Line
            ctxSkater.strokeStyle = '#334155';
            ctxSkater.lineWidth = 2;
            ctxSkater.beginPath();
            ctxSkater.moveTo(20, cy + 80);
            ctxSkater.lineTo(w - 20, cy + 80);
            ctxSkater.stroke();

            // Skater Body (Top View / Front Dynamic Representation)
            ctxSkater.save();
            ctxSkater.translate(cx, cy - 10);

            // Head
            ctxSkater.fillStyle = '#f59e0b';
            ctxSkater.beginPath();
            ctxSkater.arc(0, -30, 14, 0, Math.PI * 2);
            ctxSkater.fill();

            // Torso
            ctxSkater.strokeStyle = '#3b82f6';
            ctxSkater.lineWidth = 6;
            ctxSkater.beginPath();
            ctxSkater.moveTo(0, -16);
            ctxSkater.lineTo(0, 30);
            ctxSkater.stroke();

            // Arms (Length depends on factor & rotates)
            const armSpan = 60 * (1 - 0.65 * factor);
            const armX = Math.cos(skaterAngle) * armSpan;

            ctxSkater.strokeStyle = '#10b981';
            ctxSkater.lineWidth = 5;
            ctxSkater.beginPath();
            ctxSkater.moveTo(-armX, -5);
            ctxSkater.lineTo(armX, -5);
            ctxSkater.stroke();

            ctxSkater.restore();

            requestAnimationFrame(drawSkater);
        }

        skaterArmSlider.addEventListener('input', drawSkater);
        drawSkater();


        // ==========================================
        // SECTION 5: QUIZ INTERACTIVE VALIDATION
        // ==========================================
        let score = 0;
        const answered = { 1: false, 2: false, 3: false, 4: false };

        function checkAnswer(qNum, choice, isCorrect) {
            if (answered[qNum]) return;
            answered[qNum] = true;

            const feedback = document.getElementById(`qFeedback${qNum}`);
            const buttons = document.querySelectorAll(`.qBtn${qNum}`);

            buttons.forEach(btn => btn.disabled = true);

            feedback.classList.remove('hidden');
            if (isCorrect) {
                score++;
                feedback.className = 'text-xs p-3 rounded font-medium bg-emerald-100 text-emerald-900 border border-emerald-300';
                feedback.innerHTML = '&#10004; <strong>¡Correcto!</strong> ' + getExplanation(qNum);
            } else {
                feedback.className = 'text-xs p-3 rounded font-medium bg-rose-100 text-rose-900 border border-rose-300';
                feedback.innerHTML = '&#10008; <strong>Incorrecto.</strong> ' + getExplanation(qNum);
            }

            const scoreBadge = document.getElementById('quizScoreBadge');
            const scoreText = document.getElementById('quizScoreText');
            scoreBadge.classList.remove('hidden');
            scoreText.innerText = `${score}/4`;
        }

        function getExplanation(qNum) {
            switch(qNum) {
                case 1: return 'El desplazamiento angular es \u0394\u03B8 = s / r = 9.42 m / 0.6 m = 15.7 rad.';
                case 2: return 'La velocidad angular es \u03C9 = \u0394\u03B8 / \u0394t = 15.7 rad / 5 s = 3.14 rad/s.';
                case 3: return 'La fuerza centrípeta es la fuerza neta dirigida hacia el centro que produce el cambio de dirección en la velocidad.';
                case 4: return 'Por conservación de L (I\u2081\u03C9\u2081 = I\u2082\u03C9\u2082), si el momento de inercia disminuye a la mitad, la velocidad angular debe duplicarse.';
            }
        }
    </script>
</body>
</html>